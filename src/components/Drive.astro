---
// A divider line with a small car that drives along it now and then while the line is on screen
// (src/scripts/drive.ts): the site's version of the fishes on the Tofo dive club site. The car is the
// racing-car emoji of the visitor's own device (red Formula 1 car in every emoji set), mirrored so it
// faces the way it drives, left to right. Decorative; still with motion reduced.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<span class:list={['track', cls]} aria-hidden="true" data-track>
  <span class="drive" data-drive><span class="car">🏎️</span></span>
</span>
