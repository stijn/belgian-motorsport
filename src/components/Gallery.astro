---
// The photo grid: a hand-picked set from his Flickr albums (src/data/gallery.json, files in
// src/assets/gallery/). Dense grid: the two featured photos take 2×2 cells and the rest flow around
// them, so no cell stays empty. Each opens in the lightbox; the caption links the album and the photo
// on Flickr (new window), where prints can be bought.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fa from './Fa.astro';
import LineMd from './LineMd.astro';
import SocialIcon from './SocialIcon.astro';
import SectionHead from './SectionHead.astro';
import { faExpand } from '@fortawesome/free-solid-svg-icons';
import gallery from '../data/gallery.json';
import { accounts, socials } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true });
const flickr = socials.find((s) => s.key === 'flickr')!;
const items = await Promise.all(
  gallery
    .map((g) => ({ ...g, src: masters[`../assets/gallery/${g.file}`]?.default }))
    .filter((g) => g.src)
    .map(async (g) => {
      const full = await getImage({ src: g.src!, width: Math.min(1600, g.src!.width), format: 'webp', quality: 80 });
      const albumUrl = `https://www.flickr.com/photos/${accounts.flickrPathAlias}/albums/${g.albumId}/`;
      const photoUrl = `https://www.flickr.com/photos/${accounts.flickrPathAlias}/${g.flickrId}/`;
      return { ...g, full: full.src, albumUrl, photoUrl };
    }),
);
---
<section id="photos" class="section work">
  <div class="wrap">
    <SectionHead icon="camera" eyebrow={d.gallery.eyebrow} heading={d.gallery.heading} lead={d.gallery.lead} />

    <ul class="grid" data-stagger>
      {items.map((g) => (
        <li class:list={['tile rv', { featured: g.featured }]}>
          <figure>
            <button
              type="button"
              class="open ph"
              data-lightbox
              data-full={g.full}
              data-alt={g.alt}
              data-caption={`${g.title} · ${g.event}`}
              data-link={g.photoUrl}
              aria-label={`${d.gallery.open}: ${g.title}`}
            >
              <Picture
                src={g.src!}
                alt={g.alt}
                widths={g.featured ? [480, 800, 1200, 1600] : [360, 540, 800]}
                sizes={g.featured ? '(min-width: 1100px) 840px, 100vw' : '(min-width: 1100px) 410px, (min-width: 640px) 50vw, 100vw'}
                formats={['avif', 'webp']}
                quality={g.featured ? 62 : 60}
                loading="lazy"
              />
              <span class="zoom" aria-hidden="true"><Fa icon={faExpand} /></span>
            </button>
            <figcaption class="cap">
              <span class="cap-t">{g.title}</span>
              <span class="cap-row">
                <a href={g.albumUrl} target="_blank" rel="noopener">{g.event}</a>
                <a class="cap-link" href={g.photoUrl} target="_blank" rel="noopener" aria-label={`${d.gallery.seeOnFlickr}: ${g.title}`}><SocialIcon network="flickr" /> {d.gallery.seeOnFlickr}</a>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <p class="more rv">
      <a class="link-arrow" data-replay href={flickr.url} target="_blank" rel="me noopener">
        <SocialIcon network="flickr" /> {d.gallery.allAlbums} <LineMd name="arrow-right" />
      </a>
    </p>
  </div>
</section>
{/* The lightbox is built by src/scripts/lightbox.ts; its icons and labels come from here. */}
<template data-lightbox-icons data-prev={d.gallery.prev} data-next={d.gallery.next} data-close={d.gallery.close} data-see={d.gallery.seeOnFlickr}>
  <span data-icon="prev"><LineMd name="arrow-left" /></span>
  <span data-icon="next"><LineMd name="arrow-right" /></span>
  <span data-icon="close"><LineMd name="close" /></span>
</template>
<script>
  import '../scripts/lightbox';
  import '../scripts/photos';
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(3, 1fr);
    /* Later tiles fill any hole a 2×2 tile leaves behind. */
    grid-auto-flow: dense;
  }
  .featured {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (max-width: 1099px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .featured {
      grid-column: auto;
      grid-row: auto;
    }
  }
  figure {
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.6rem;
    height: 100%;
  }
  .open {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--bg-3);
    cursor: zoom-in;
    overflow: hidden;
  }
  .featured .open {
    aspect-ratio: auto;
    height: 100%;
  }
  .open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), opacity 0.6s;
  }
  .tile:hover .open :global(img),
  .open:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--bg);
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s, transform 0.3s var(--ease);
  }
  .tile:hover .zoom,
  .open:focus-visible .zoom {
    opacity: 1;
    transform: none;
  }
  figcaption {
    transition: transform 0.5s var(--ease);
  }
  .tile:hover figcaption {
    transform: translateX(4px);
  }
  .more {
    margin-top: var(--s5);
  }
</style>

<style is:global>
  /* The lightbox (built by src/scripts/lightbox.ts), shared with the films. */
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(5 5 6 / 0.94);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.3s var(--ease);
  }
  @keyframes lb-in {
    from { opacity: 0; }
  }
  .lb-stage {
    display: grid;
    place-items: center;
    gap: var(--s3);
    width: 100%;
    height: 100%;
    padding: clamp(3.5rem, 8vh, 5rem) clamp(1rem, 6vw, 5rem) clamp(2.5rem, 6vh, 4rem);
    grid-template-rows: 1fr auto;
  }
  .lb-stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  :global(.js-motion) .lb-stage img.lb-switch {
    animation: lb-img 0.45s var(--ease);
  }
  @keyframes lb-img {
    from { opacity: 0; transform: scale(0.97); }
  }
  .lb-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem var(--s4);
    text-align: center;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .lb-caption a {
    color: var(--text);
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  .lb-btn:hover {
    background: var(--red);
    border-color: var(--red);
  }
  .lb-btn .icon-line {
    font-size: 1.1em;
  }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-close { right: 1rem; top: 1rem; }
  .lb-count {
    position: fixed;
    left: 1.25rem;
    top: 1.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-2);
  }
  @media (max-width: 640px) {
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; }
  }
  /* The film player, in the same frame: as wide as the stage allows, 16:9, never taller than the stage. */
  .lightbox .lb-frame {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .lightbox .lb-film {
    width: min(100%, 1280px, calc((100vh - 9rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    border: 0;
    background: #000;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
</style>
