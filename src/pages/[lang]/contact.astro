---
// The same page in Dutch, French, German and Italian (English lives at the root).
import ContactPage from '../../views/ContactPage.astro';
import { langs, defaultLang, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<ContactPage lang={lang} />
