---
// The 404 page in the other languages. Cloudflare serves the nearest 404.html to the missing path, so
// tools/postbuild.mjs moves this page from /nl/404/index.html to /nl/404.html after the build.
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { site } from '../../data/site';
import { href } from '../../lib/url';
import { langs, defaultLang, t, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} path="/404/" title={`${d.notFound.title} — ${site.name}`} noindex>
  <section class="section">
    <div class="wrap center">
      <SectionHead level={1} icon="alert-circle" eyebrow="404" heading={d.notFound.heading} lead={d.notFound.text} />
      <p class="cta">
        <a class="btn btn-red" href={href('/', lang)}>{d.notFound.back}</a>
        <a class="btn btn-ghost" href={href('/#photos', lang)}>{d.notFound.photos}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .center {
    display: grid;
    gap: var(--s4);
    justify-items: start;
    max-width: 760px;
    min-height: 60svh;
    align-content: center;
  }
  .cta {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
  }
</style>
