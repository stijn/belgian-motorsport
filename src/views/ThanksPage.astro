---
// Where the form lands without JavaScript (the Worker redirects here after sending).
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { href } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} path="/thanks/" title={`${d.thanks.title} — ${site.name}`} noindex>
  <section class="section">
    <div class="wrap center">
      <SectionHead level={1} icon="email-check" eyebrow={d.thanks.eyebrow} heading={d.thanks.heading} lead={d.thanks.text} />
      <p><a class="btn btn-ghost" href={href('/', lang)}>{d.thanks.back}</a></p>
    </div>
  </section>
</Base>

<style>
  .center {
    display: grid;
    gap: var(--s4);
    justify-items: start;
    max-width: 760px;
    min-height: 50svh;
    align-content: center;
  }
</style>
