---
// The contact form. It posts to the Worker (worker/index.ts), which sends the message on by email;
// his address lives only in a Worker secret, so it never appears in the page. Spam defences: a
// honeypot field, a minimum time to fill in the form, a rate limit, and Turnstile when configured.
import Fa from './Fa.astro';
import LineMd from './LineMd.astro';
import { faFlagCheckered, faLock, faEnvelopeOpenText } from '@fortawesome/free-solid-svg-icons';
import { contact } from '../data/site';
import { href } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = t(lang).contact.form;
const turnstile = contact.turnstileSiteKey;
---
<form
  class="contact-form"
  method="post"
  action={contact.endpoint}
  data-contact-form
  data-msg-sending={f.sending}
  data-msg-sent={f.sent}
  data-msg-fail={f.fail}
  data-msg-offline={f.offline}
  novalidate
>
  <div class="two">
    <div class="field" data-replay>
      <label for="cf-name"><LineMd name="account" /><span>{f.name}</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" />
    </div>
    <div class="field" data-replay>
      <label for="cf-email"><LineMd name="email" /><span>{f.email}</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" inputmode="email" />
    </div>
  </div>
  <div class="field" data-replay>
    <label for="cf-message"><LineMd name="text-box" /><span>{f.message}</span></label>
    <p class="hint" id="cf-message-hint">{f.hint}</p>
    <textarea id="cf-message" name="message" required minlength="10" maxlength="5000" rows="6" aria-describedby="cf-message-hint"></textarea>
  </div>
  {/* Honeypot: people never see it; bots fill it in. */}
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="started" value="" />
  {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-theme="dark" data-size="flexible"></div>}
  <div class="actions">
    <button class="btn btn-red" type="submit"><Fa icon={faFlagCheckered} class="flag" />{f.send}</button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
  <p class="privacy">
    <span class="pv"><Fa icon={faLock} /> <Fa icon={faEnvelopeOpenText} /></span>
    <span>{f.privacy} <a href={href('/privacy/', lang)}>{f.privacyLink}</a>.</span>
  </p>
  <template data-status-icons>
    <span data-icon="sending"><LineMd name="loading-twotone-loop" /></span>
    <span data-icon="ok"><LineMd name="email-check" /></span>
    <span data-icon="error"><LineMd name="alert-circle" /></span>
  </template>
</form>
{turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--s4);
  }
  .two {
    display: grid;
    gap: var(--s4);
  }
  @media (min-width: 640px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field label {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .field label .icon-line {
    color: var(--red);
    font-size: 1.2em;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s4);
  }
  .btn .flag {
    font-size: 1.1em;
    transition: transform 0.3s var(--ease);
  }
  .js-motion .btn:hover .flag {
    animation: flag-wave 0.6s var(--ease) infinite;
  }
  @keyframes flag-wave {
    0%, 100% { transform: rotate(0); }
    30% { transform: rotate(-12deg); }
    70% { transform: rotate(8deg); }
  }
  .status {
    min-height: 1.5em;
    color: var(--text-2);
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .status .icon-line {
    font-size: 1.3em;
  }
  .status[data-kind='ok'] {
    color: #7ed9a0;
  }
  .status[data-kind='error'] .icon-line {
    color: var(--red);
  }
  .sent .two,
  .sent .field,
  .sent button {
    display: none;
  }
  .sent .status {
    font-size: 1.25rem;
    color: var(--text);
  }
  .privacy {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-size: 0.9rem;
    color: var(--text-3);
  }
  .pv {
    display: inline-flex;
    gap: 0.35em;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
  }
  .privacy a {
    color: var(--text-2);
  }
</style>
