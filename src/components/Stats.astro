---
// The numbers, in one strip. They're rounded down in src/data/site.ts so they stay true for a while.
import { stats } from '../data/site';
const years = new Date(stats.asOf).getFullYear() - stats.since;
---
<section id="stats" class="stats" aria-label="In numbers">
  <div class="wrap">
    <ul data-stagger>
      <li class="rv"><span class="value num" data-count={String(years)}>{years}</span><span class="label">years trackside</span></li>
      {stats.items.map((s) => (
        <li class="rv"><span class="value num" data-count={s.value}>{s.value}<i>+</i></span><span class="label">{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>
<script>
  import '../scripts/stats';
</script>

<style>
  .stats {
    border-block: 1px solid var(--line);
    background: var(--bg-2);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: var(--s4) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s3) var(--s4);
  }
  li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: var(--s2) 0;
    padding-left: var(--s3);
  }
  /* The red marker draws down as the item reveals. */
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--red);
    transform-origin: top;
    transition: transform 0.8s var(--ease) 0.2s;
  }
  .js-motion li:not(.in)::before {
    transform: scaleY(0);
  }
  .value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .value i {
    font-style: normal;
    color: var(--red-2);
    font-size: 0.6em;
    vertical-align: 0.35em;
    margin-left: 0.05em;
  }
  .label {
    font-size: 0.95rem;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
</style>
