---
// Sticky header: the BM logo, the sections with their icons, and the language switcher. Over the hero
// it is transparent with a soft shade; a dark bar once the page scrolls (src/scripts/header.ts). No
// social links here: a new visitor should land in the work, not leave for YouTube; the footer has them.
import { Image } from 'astro:assets';
import logo from '../assets/bm-logo.png';
import LineMd from './LineMd.astro';
import Fa from './Fa.astro';
import { faLanguage, faCheck } from '@fortawesome/free-solid-svg-icons';
import { site, sections } from '../data/site';
import { href } from '../lib/url';
import { langs, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path?: string;
  overHero?: boolean;
}
const { lang, path = '/', overHero = false } = Astro.props;
const d = t(lang);
const nav = sections.map((s) => ({ ...s, label: d.nav[s.key], href: href(`/#${s.id}`, lang) }));
// Alphabetical by each language's own name: Deutsch, English, Français, Italiano, Nederlands.
const languages = langs
  .map((l) => ({ lang: l, name: t(l).name, code: t(l).htmlLang, href: href(path, l), current: l === lang }))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<header class:list={['site-header', { 'over-hero': overHero, 'brand-hidden': overHero }]} data-header>
  <div class="wrap bar">
    <a class="brand" href={href('/', lang)} aria-label={`${site.name}, ${d.nav.home}`} data-brand>
      <Image src={logo} alt="" width="138" height="51" densities={[1, 2, 3]} loading="eager" class="brand-logo" />
      <span class="brand-text"><strong>{site.name}</strong><em>{site.tagline}</em></span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label={d.nav.site} data-menu>
      <ul class="nav-links">
        {nav.map((n) => (
          <li><a href={n.href} data-nav data-replay><LineMd name={n.icon} /><span>{n.label}</span></a></li>
        ))}
      </ul>
      <div class="nav-langs" aria-label={d.nav.languages}>
        <p class="nav-langs-label"><Fa icon={faLanguage} /> {d.nav.languages}</p>
        <ul>
          {languages.map((l) => (
            <li><a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.current ? 'page' : undefined}>{l.name}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="right">
      {/* Desktop language switcher: a native disclosure, keyboard-friendly without JS. */}
      <details class="lang" data-lang>
        <summary data-tip={d.nav.languages}>
          <Fa icon={faLanguage} /><span class="visually-hidden">{d.nav.languages}: </span><span>{d.name}</span>
        </summary>
        <ul class="lang-list">
          {languages.map((l) => (
            <li>
              <a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.current ? 'page' : undefined}>
                {l.name}{l.current && <Fa icon={faCheck} class="tick" />}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
        <span class="menu-label">{d.nav.menu}</span>
      </button>
    </div>
  </div>
</header>
<script>
  import '../scripts/header';
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    /* Above the back-to-top flag (80) and the status notes (90+), so an open phone menu covers them. */
    z-index: 100;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.4s;
  }
  /* The dark, blurred bar lives on a pseudo-element: a backdrop-filter on the header itself would make
     it the containing block of the fixed phone menu, which then collapses to the header's own box. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(11 11 12 / 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: background 0.4s;
  }
  /* Over the hero the bar floats on a soft shade until the page scrolls; the links carry a halo. */
  .site-header.over-hero:not(.scrolled) {
    position: fixed;
    inset-inline: 0;
    border-color: transparent;
  }
  .site-header.over-hero:not(.scrolled)::before {
    background: linear-gradient(rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.35) 70%, transparent);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .site-header.over-hero.scrolled {
    position: fixed;
    inset-inline: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    min-height: var(--header-h);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    flex: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .brand-hidden .brand {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }
  .brand-logo {
    width: 138px;
    height: auto;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.5));
  }
  .brand-text {
    display: none;
  }
  @media (min-width: 1180px) {
    .brand-text {
      display: grid;
      line-height: 1.1;
      border-left: 1px solid var(--line-2);
      padding-left: 0.9rem;
    }
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand-text em {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .right {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--s5);
    margin-left: auto;
  }
  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.9), 0 0 10px rgb(0 0 0 / 0.8);
    padding: 0.5rem 0;
    position: relative;
  }
  .nav-links .icon-line {
    font-size: 1.05em;
    color: var(--red);
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0.1rem;
    height: 2px;
    background: var(--red);
    transition: right 0.3s var(--ease);
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    right: 0;
  }
  .nav-langs {
    display: none;
  }

  /* Language switcher */
  .lang {
    position: relative;
  }
  .lang summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.95rem;
    cursor: pointer;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.9);
    background: rgb(11 11 12 / 0.55);
    transition: border-color 0.2s, background 0.2s;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang summary .icon {
    font-size: 1.2em;
    color: var(--red);
  }
  .lang summary:hover,
  .lang[open] summary {
    border-color: var(--text);
    background: var(--bg-2);
  }
  .lang-list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 11rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
    z-index: 5;
  }
  .js-motion .lang[open] .lang-list {
    animation: drop 0.25s var(--ease);
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-6px); }
  }
  .lang-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: 0.5rem 0.8rem;
    border-radius: 3px;
    text-decoration: none;
    color: var(--text);
    /* Bold and 19.2px: large text for WCAG, so white on the red hover reads at 5:1. */
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }
  .lang-list a:hover,
  .lang-list a:focus-visible {
    background: var(--red);
    color: #fff;
  }
  .lang-list a[aria-current] {
    color: var(--text);
  }
  .tick {
    font-size: 0.85em;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    background: rgb(11 11 12 / 0.55);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-lines {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-lines i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
    transform-origin: center;
  }
  .menu-btn[aria-expanded='true'] .menu-lines i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-lines i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .menu-btn {
      display: inline-flex;
    }
    .lang {
      display: none;
    }
    .site-nav {
      position: fixed;
      top: var(--header-h);
      inset-inline: 0;
      bottom: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: var(--s4);
      padding: var(--s4) var(--gutter) calc(var(--s5) + env(safe-area-inset-bottom));
      background: rgb(11 11 12 / 0.98);
      overflow: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.4s var(--ease), visibility 0s 0.4s;
    }
    .site-nav.open {
      transform: none;
      visibility: visible;
      transition: transform 0.4s var(--ease);
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-links li + li {
      border-top: 1px solid var(--line);
    }
    .nav-links a {
      display: flex;
      font-size: clamp(2rem, 9vw, 3rem);
      padding: 0.6rem 0;
      text-shadow: none;
    }
    .nav-links a::after {
      display: none;
    }
    .nav-links li {
      opacity: 0;
      transform: translateX(24px);
      transition: opacity 0.4s var(--ease), transform 0.5s var(--ease);
    }
    .site-nav.open .nav-links li {
      opacity: 1;
      transform: none;
    }
    .site-nav.open .nav-links li:nth-child(1) { transition-delay: 0.1s; }
    .site-nav.open .nav-links li:nth-child(2) { transition-delay: 0.16s; }
    .site-nav.open .nav-links li:nth-child(3) { transition-delay: 0.22s; }
    .site-nav.open .nav-links li:nth-child(4) { transition-delay: 0.28s; }
    .site-nav.open .nav-links li:nth-child(5) { transition-delay: 0.34s; }
    .nav-langs {
      display: block;
      opacity: 0;
      transition: opacity 0.4s 0.4s;
    }
    .site-nav.open .nav-langs {
      opacity: 1;
    }
    .nav-langs-label {
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: 0.85rem;
      color: var(--text-3);
      margin-bottom: var(--s2);
    }
    .nav-langs-label .icon {
      color: var(--red);
      font-size: 1.2em;
    }
    .nav-langs ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: var(--s2);
    }
    .nav-langs a {
      display: inline-block;
      padding: 0.5rem 0.9rem;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      text-decoration: none;
      color: var(--text);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: 0.06em;
    }
    .nav-langs a:hover,
    .nav-langs a:focus-visible,
    .nav-langs a[aria-current] {
      background: var(--red);
      border-color: var(--red);
      color: #fff;
    }
  }
</style>
