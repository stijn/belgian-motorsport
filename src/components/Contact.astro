---
// The contact section: his words from the old site, and the form.
import ContactForm from './ContactForm.astro';
import SectionHead from './SectionHead.astro';
import SocialIcon from './SocialIcon.astro';
import { socials, site } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---
<section id="contact" class="section contact">
  <div class="wrap grid">
    <div class="intro">
      <SectionHead icon="email" eyebrow={d.contact.eyebrow} heading={d.contact.heading} />
      <p class="lead rv">{d.contact.text}</p>
      <p class="rv">{d.contact.more}</p>
      <ul class="dm rv" aria-label={d.contact.dm}>
        {socials.filter((s) => s.key === 'instagram' || s.key === 'facebook').map((s) => (
          <li><a href={s.url} target="_blank" rel="me noopener"><SocialIcon network={s.key} /> {s.name}</a></li>
        ))}
      </ul>
      <p class="based rv">{site.name} · {d.contact.basedIn}</p>
    </div>
    <div class="form rv">
      <ContactForm lang={lang} />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--s5);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--s6);
    }
  }
  .intro p {
    color: var(--text-2);
    max-width: 44ch;
  }
  .intro .lead {
    margin-top: var(--s3);
    color: var(--text);
  }
  .intro p + p {
    margin-top: var(--s3);
  }
  .dm {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: 0;
    display: flex;
    gap: var(--s2);
  }
  .dm a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dm a:hover {
    border-color: var(--text);
  }
  .based {
    margin-top: var(--s5) !important;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--text-3) !important;
  }
  .form {
    position: relative;
    padding: clamp(var(--s4), 3vw, var(--s5));
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
