---
// The page shell: fonts, metadata for search and sharing in five languages, header, footer, the
// back-to-top flag, offline support.
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '../styles/global.css';
// The two faces on the first screen, preloaded so the headline never paints in a fallback first.
import barlowCondensed800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import barlow500 from '@fontsource/barlow/files/barlow-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import FaSprite from '../components/FaSprite.astro';
import Footer from '../components/Footer.astro';
import ToTop from '../components/ToTop.astro';
import { site, socials, stats } from '../data/site';
import { href, demo } from '../lib/url';
import { langs, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** The page's path after the language prefix: '/' for home, '/contact/' for contact. */
  path?: string;
  title?: string;
  description?: string;
  /** Pages that shouldn't be in search results (thanks, 404). */
  noindex?: boolean;
  /** The header starts over a full-bleed hero. */
  overHero?: boolean;
  /** Extra JSON-LD for this page. */
  schema?: Record<string, unknown>[];
  /** Which share card (public/og-*.jpg, made by tools/share-cards.mjs). */
  card?: 'home' | 'contact' | 'privacy';
  cardAlt?: string;
}
const d = t(Astro.props.lang);
const {
  lang,
  path = '/',
  title = d.meta.title,
  description = d.meta.description,
  noindex = false,
  overHero = false,
  schema = [],
  card = 'home',
  cardAlt = d.meta.cardHome,
} = Astro.props;
const canonical = new URL(href(path, lang), Astro.site).href;
const ogImage = new URL(href(`/og-${card}.jpg`), Astro.site).href;
const ogSquare = new URL(href(`/og-${card}-square.jpg`), Astro.site).href;
const alternates = langs.map((l) => ({ lang: l, hreflang: t(l).htmlLang, url: new URL(href(path, l), Astro.site).href }));

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site.url}/#org`,
  name: site.name,
  alternateName: 'BM',
  slogan: site.tagline,
  description: d.meta.description,
  url: site.url + '/',
  logo: new URL(href('/bm-logo.png'), Astro.site).href,
  image: ogImage,
  foundingDate: String(stats.since),
  areaServed: ['Belgium', 'Europe'],
  address: { '@type': 'PostalAddress', addressCountry: 'BE' },
  knowsAbout: ['Motorsport photography', 'Motorsport videography', 'Endurance racing', 'Historic racing', 'Rallying', 'Supercars'],
  sameAs: socials.map((s) => s.url),
  contactPoint: { '@type': 'ContactPoint', contactType: 'bookings', url: `${site.url}/#contact`, availableLanguage: [...langs] },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url + '/',
  name: site.name,
  description: d.meta.description,
  inLanguage: d.htmlLang,
  publisher: { '@id': `${site.url}/#org` },
};
---

<!doctype html>
<html lang={d.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* JS and motion classes before the first paint; js-return = arrived from another page of this
        site, so the intros don't play again. public/_headers allows this script by its hash;
        tests/headers.test.ts checks the hash still matches whenever this line changes. */}
    <script is:inline>document.documentElement.className=(matchMedia('(prefers-reduced-motion: reduce)').matches?'js':'js js-motion')+(document.referrer.indexOf(location.origin+'/')==0?' js-return':'')</script>
    {noindex || demo ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    {/* Browsers that support it render the next page in the background as soon as a link is hovered
        or pressed (Chrome, Edge): a language switch or the contact page then opens at once. Pages only. */}
    <script is:inline type="speculationrules">{"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/api/*"}},{"not":{"selector_matches":"[target=_blank]"}}]},"eagerness":"moderate"}]}</script>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={barlowCondensed800} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={barlow500} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href(path, 'en'), Astro.site).href} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="48x48" />
    <link rel="icon" href={href('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    {/* A square version for the networks that crop to one (WhatsApp, Mastodon, iMessage). */}
    <meta property="og:image" content={ogSquare} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta property="og:locale" content={d.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).ogLocale} />)}
    <meta property="og:see_also" content={socials[0].url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={cardAlt} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="application-name" content={site.name} />
    {socials.map((s) => <link rel="me" href={s.url} />)}
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify([org, website, ...schema])} />
    <slot name="head" />
  </head>
  <body>
    <FaSprite />
    <div class="tricolour" aria-hidden="true"></div>
    <a class="skip" href="#main">{d.nav.skip}</a>
    <Header lang={lang} path={path} overHero={overHero} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ToTop lang={lang} />
    <aside aria-label="Status">
      <p class="offline-note" role="status" data-offline data-text={d.notes.offline}></p>
      <p class="update-note" role="status" data-update hidden>
        <span>{d.notes.newer}</span>
        <button type="button" class="btn btn-red btn-small">{d.notes.reload}</button>
      </p>
    </aside>
    <script>
      import '../scripts/reveal';
      import '../scripts/line-md';
      import '../scripts/delight';
      import '../scripts/drive';
      import '../scripts/offline';
    </script>
  </body>
</html>
