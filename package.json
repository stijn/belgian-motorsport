{
  "name": "belgian-motorsport",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Belgian Motorsport: portfolio and business card of a Belgian motorsport photographer and filmmaker. Static Astro site on Cloudflare Workers, with one small Worker for the contact form.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check && tsc -p worker",
    "test": "vitest run",
    "sync": "node tools/sync.mjs",
    "icons": "node tools/icons.mjs",
    "deploy": "astro build && wrangler deploy",
    "deploy:demo": "PUBLIC_DEMO=1 SITE=https://belgian-motorsport-demo.stijn-vogels.workers.dev astro build && wrangler deploy --env demo"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "astro": "^7.4.10",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  }
}
