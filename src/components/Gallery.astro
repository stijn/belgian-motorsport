---
// The photo grid: a hand-picked set from his Flickr albums (src/data/gallery.json, files in
// src/assets/gallery/). Each opens in the lightbox at a larger size; the caption links the album.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fa from './Fa.astro';
import LineMd from './LineMd.astro';
import SocialIcon from './SocialIcon.astro';
import { faExpand } from '@fortawesome/free-solid-svg-icons';
import gallery from '../data/gallery.json';
import { accounts, socials } from '../data/site';

const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true });
const flickr = socials.find((s) => s.key === 'flickr')!;
const items = await Promise.all(
  gallery
    .map((g) => ({ ...g, src: masters[`../assets/gallery/${g.file}`]?.default }))
    .filter((g) => g.src)
    .map(async (g) => {
      // The lightbox shows a large WebP (the masters are 1024px or 1600px wide).
      const full = await getImage({ src: g.src!, width: Math.min(1600, g.src!.width), format: 'webp', quality: 80 });
      const albumUrl = `https://www.flickr.com/photos/${accounts.flickrPathAlias}/albums/${g.albumId}/`;
      return { ...g, full: full.src, albumUrl };
    }),
);
---
<section id="work" class="section work">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow rv">Photos</p>
        <h2 class="h2 rv">Trackside, pit lane and stage</h2>
      </div>
      <p class="lead rv">A handful from the albums: Formula 1 and Group C at the historic grands prix, Hypercars at Spa, rally cars in the dust of Limburg and the Eifel.</p>
    </div>

    <ul class="grid" data-stagger>
      {items.map((g, i) => (
        <li class:list={['tile rv', { featured: g.featured }]}>
          <figure>
            <button type="button" class="open ph" data-lightbox data-full={g.full} data-alt={g.alt} data-caption={`${g.title} · ${g.event}`} aria-label={`Open: ${g.title}`}>
              <Picture
                src={g.src!}
                alt={g.alt}
                widths={g.featured ? [480, 800, 1200, 1600] : [360, 540, 800]}
                sizes={g.featured ? '(min-width: 1100px) 840px, 100vw' : '(min-width: 1100px) 410px, (min-width: 640px) 50vw, 100vw'}
                formats={['avif', 'webp']}
                quality={g.featured ? 68 : 64}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
              <span class="zoom" aria-hidden="true"><Fa icon={faExpand} /></span>
            </button>
            <figcaption>
              <span class="t">{g.title}</span>
              <a class="e" href={g.albumUrl} rel="noopener">{g.event}</a>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <p class="more rv">
      <a class="link-arrow" data-replay href={flickr.url} rel="me noopener">
        <SocialIcon network="flickr" /> Every album on Flickr <LineMd name="arrow-right" />
      </a>
    </p>
  </div>
</section>
{/* The lightbox is built by src/scripts/lightbox.ts; its icons come from here so they animate. */}
<template data-lightbox-icons>
  <span data-icon="prev"><LineMd name="arrow-left" /></span>
  <span data-icon="next"><LineMd name="arrow-right" /></span>
  <span data-icon="close"><LineMd name="close" /></span>
</template>
<script>
  import '../scripts/lightbox';
  import '../scripts/photos';
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .featured {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  figure {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .open {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--bg-3);
    cursor: zoom-in;
    overflow: hidden;
  }
  .open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), opacity 0.6s;
  }
  .tile:hover .open :global(img),
  .open:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s, transform 0.3s var(--ease);
  }
  .tile:hover .zoom,
  .open:focus-visible .zoom {
    opacity: 1;
    transform: none;
  }
  figcaption {
    transition: transform 0.5s var(--ease), color 0.3s;
  }
  .tile:hover figcaption {
    transform: translateX(4px);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .t {
    font-weight: 500;
  }
  .e {
    color: var(--text-3);
    text-decoration: none;
    text-align: right;
    flex: none;
    max-width: 50%;
  }
  .e:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .more {
    margin-top: var(--s5);
  }
</style>

<style is:global>
  /* The lightbox (built by src/scripts/lightbox.ts). */
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(5 5 6 / 0.94);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.3s var(--ease);
  }
  @keyframes lb-in {
    from { opacity: 0; }
  }
  .lb-stage {
    display: grid;
    place-items: center;
    gap: var(--s3);
    width: 100%;
    height: 100%;
    padding: clamp(3.5rem, 8vh, 5rem) clamp(1rem, 6vw, 5rem) clamp(2.5rem, 6vh, 4rem);
    grid-template-rows: 1fr auto;
  }
  .lb-stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  .js-motion .lb-stage img.lb-switch {
    animation: lb-img 0.45s var(--ease);
  }
  @keyframes lb-img {
    from { opacity: 0; transform: scale(0.97); }
  }
  .lb-btn .icon-line {
    font-size: 1.1em;
  }
  .lb-caption {
    text-align: center;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  .lb-btn:hover {
    background: var(--red);
    border-color: var(--red);
  }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-close { right: 1rem; top: 1rem; }
  .lb-count {
    position: fixed;
    left: 1.25rem;
    top: 1.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-2);
  }
  @media (max-width: 640px) {
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; }
  }
</style>
