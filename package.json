{
  "name": "belgian-motorsport",
  "private": true,
  "version": "1.10.5",
  "type": "module",
  "description": "Belgian Motorsport: portfolio and business card of a Belgian motorsport photographer and filmmaker. Static Astro site on Cloudflare Workers, with one small Worker for the contact form.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/lqip.mjs && astro build && node tools/postbuild.mjs",
    "preview": "astro build && wrangler dev",
    "check": "astro check && tsc -p worker",
    "test": "vitest run",
    "sync": "node tools/sync.mjs",
    "icons": "node tools/icons.mjs",
    "cards": "node tools/share-cards.mjs",
    "seo": "node tools/seo-check.mjs",
    "lqip": "node tools/lqip.mjs",
    "deploy": "npm run build && node tools/seo-check.mjs && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify/utils": "^3.1.7",
    "astro": "^7.4.10",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "axe-core": "^4.14.0",
    "lighthouse": "^13.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  }
}
