---
// Where he's been: his Flickr albums by year (src/data/albums.json, npm run sync), each linking to the
// full album in a new window. A wrapping grid, so the page scrolls the way the rest of it does.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LineMd from './LineMd.astro';
import SocialIcon from './SocialIcon.astro';
import SectionHead from './SectionHead.astro';
import Drive from './Drive.astro';
import albums from '../data/albums.json';
import { blurStyle } from '../lib/lqip';
import { socials, stats } from '../data/site';
import { fill, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/albums/*.jpg', { eager: true });
const flickr = socials.find((s) => s.key === 'flickr')!;
const withCover = albums
  .map((a) => ({ ...a, img: covers[`../assets/albums/${a.cover}`]?.default }))
  .filter((a) => a.img);
const years = [...new Set(withCover.map((a) => a.year).filter((y): y is number => y !== null))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ year: y, albums: withCover.filter((a) => a.year === y) }));
const photos = stats.items.find((s) => s.key === 'photos')!.value;
---
<section id="events" class="section events">
  <div class="wrap">
    <SectionHead icon="calendar" eyebrow={d.events.eyebrow} heading={d.events.heading} lead={d.events.lead} />

    {byYear.map(({ year, albums }) => (
      <div class="year">
        <h3 class="year-label rv"><span class="num">{year}</span><Drive class="year-line" /></h3>
        <ul class="row" data-stagger>
          {albums.map((a) => (
            <li class="rv">
              <div class="album">
                <a class="cover ph" style={blurStyle(`albums/${a.cover}`)} href={a.url} target="_blank" rel="noopener" aria-label={a.title}>
                  <Picture src={a.img!} alt="" widths={[320, 480, 640]} sizes="(min-width: 900px) 300px, (min-width: 500px) 45vw, 100vw" formats={['avif', 'webp']} quality={62} loading="lazy" />
                </a>
                <span class="cap">
                  <a class="cap-t album-title" href={a.url} target="_blank" rel="noopener">{a.title}</a>
                  <span class="cap-row">
                    <span>{a.photos ? fill(d.events.photos, { n: a.photos }) : d.events.album}</span>
                    <a class="cap-link" href={a.url} target="_blank" rel="noopener" aria-label={`${d.gallery.seeOnFlickr}: ${a.title}`}><SocialIcon network="flickr" /> {d.gallery.seeOnFlickr}</a>
                  </span>
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="more rv">
      <a class="link-arrow" data-replay href={flickr.url} target="_blank" rel="me noopener">
        <SocialIcon network="flickr" /> {fill(d.events.all, { photos, albums: stats.albums })} <LineMd name="arrow-right" />
      </a>
    </p>
  </div>
</section>

<style>
  .year + .year {
    margin-top: var(--s5);
  }
  .year-label {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-3);
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s3);
  }
  .year-label :global(.year-line) {
    flex: 1;
    transform-origin: left;
    transition: transform 1.2s var(--ease) 0.2s;
  }
  :global(.js-motion) .year-label:not(.in) :global(.year-line) {
    transform: scaleX(0);
  }
  .row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: var(--s4) var(--s3);
  }
  .album {
    display: grid;
    gap: 0.6rem;
  }
  .cover {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), opacity 0.6s;
  }
  .album:hover .cover :global(img) {
    transform: scale(1.05);
  }
  .album-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }
  .album-title:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--red);
    text-underline-offset: 0.15em;
  }
  .more {
    margin-top: var(--s5);
  }
</style>
