---
// The latest films, from src/data/videos.json (npm run sync). Each is a still from the site itself;
// a click opens the film in the lightbox, from youtube-nocookie.com (src/scripts/video.ts).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fa from './Fa.astro';
import LineMd from './LineMd.astro';
import SocialIcon from './SocialIcon.astro';
import SectionHead from './SectionHead.astro';
import { faPlay, faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import videos from '../data/videos.json';
import { socials, stats } from '../data/site';
import { fill, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  count?: number;
}
const { lang, count = 6 } = Astro.props;
const d = t(lang);
const stills = import.meta.glob<{ default: ImageMetadata }>('../assets/videos/*.jpg', { eager: true });
const list = videos
  .map((v) => ({ ...v, still: stills[`../assets/videos/${v.id}.jpg`]?.default }))
  .filter((v) => v.still)
  .slice(0, count);
const youtube = socials.find((s) => s.key === 'youtube')!;
const subs = stats.items.find((s) => s.key === 'subscribers')!.value;
const films = stats.items.find((s) => s.key === 'films')!.value;
const fmt = new Intl.DateTimeFormat(d.htmlLang, { day: 'numeric', month: 'short', year: 'numeric' });
---
<section id="film" class="section film">
  <div class="wrap">
    <SectionHead icon="play" eyebrow={d.film.eyebrow} heading={d.film.heading} lead={fill(d.film.lead, { subs })} />

    <ul class="grid" data-stagger>
      {list.map((v) => (
        <li class="card rv" data-video={v.id} data-title={v.title}>
          <div class="yt-still ph">
            <Picture src={v.still!} alt="" widths={[400, 640, 960]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" formats={['avif', 'webp']} quality={62} loading="lazy" />
            <button type="button" class="play" aria-label={`${d.film.play}: ${v.title}`} data-play>
              <span class="play-disc"><Fa icon={faPlay} /></span>
            </button>
          </div>
          <div class="meta">
            <h3>{v.title}</h3>
            <p>
              <time datetime={v.published}>{fmt.format(new Date(v.published))}</time> ·
              <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">{d.film.watchOnYoutube} <Fa icon={faArrowUpRightFromSquare} class="ext" /></a>
            </p>
          </div>
        </li>
      ))}
    </ul>

    <p class="more rv">
      <a class="link-arrow" data-replay href={youtube.url} target="_blank" rel="me noopener">
        <SocialIcon network="youtube" /> {fill(d.film.allFilms, { count: films })} <LineMd name="arrow-right" />
      </a>
    </p>
  </div>
</section>
<template data-film-icons data-close={d.film.close}>
  <span data-icon="close"><LineMd name="close" /></span>
</template>
<script>
  import '../scripts/video';
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .card {
    display: grid;
    gap: var(--s3);
  }
  .yt-still {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .yt-still :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), opacity 0.6s;
  }
  .card:hover .yt-still :global(img) {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(transparent 50%, rgb(0 0 0 / 0.5));
    border: 0;
    cursor: pointer;
  }
  .play-disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-size: 1.3rem;
    padding-left: 0.2rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
    transition: transform 0.3s var(--ease), background 0.3s;
  }
  .play:hover .play-disc,
  .play:focus-visible .play-disc {
    transform: scale(1.1);
    background: #c50500;
  }
  .play-disc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--red-2);
    opacity: 0;
  }
  .play:hover .play-disc::after,
  .play:focus-visible .play-disc::after {
    animation: ring 1.2s var(--ease) infinite;
  }
  @keyframes ring {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  h3 {
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: none;
    font-weight: 600;
    line-height: 1.15;
  }
  .meta p {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-3);
  }
  .meta a {
    color: var(--text-2);
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .ext {
    font-size: 0.7em;
  }
  .more {
    margin-top: var(--s5);
  }
</style>
