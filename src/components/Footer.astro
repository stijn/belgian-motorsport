---
// Four columns: who, the four places his work lives (the old footer's labels, each in its brand colour,
// opening in a new window), this page, and rights with the credits Font Awesome's licence asks for.
// A small delight: hover the logo and the racing-car emoji races along the tricolour.
import { Image } from 'astro:assets';
import logo from '../assets/bm-logo.png';
import SocialIcon from './SocialIcon.astro';
import { site, socials, sections } from '../data/site';
import { href } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const [before, after] = d.footer.rightsText.split('{link}');
---
<footer class="site-footer" data-footer>
  <div class="wrap grid">
    <div class="col about">
      <a href={href('/', lang)} class="logo" aria-label={`${site.name}, ${d.nav.home}`} data-delight="race">
        <Image src={logo} alt="" width="160" height="59" densities={[1, 2]} />
      </a>
      <p class="tagline">{site.tagline}</p>
      <p class="blurb">{d.footer.blurb}</p>
    </div>
    <nav class="col" aria-label={d.footer.networks}>
      <h2 class="label">{d.footer.networks}</h2>
      <ul class="networks">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="me noopener" style={`--brand:${s.color}`} data-tip={s.handle}>
              <span class="dot"><SocialIcon network={s.key} /></span>
              <span>{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="col links" aria-label={d.footer.onThisPage}>
      <h2 class="label">{d.footer.onThisPage}</h2>
      <ul>
        {sections.map((s) => <li><a href={href(`/#${s.id}`, lang)}>{d.nav[s.key]}</a></li>)}
        <li><a href={href('/privacy/', lang)}>{d.footer.privacy}</a></li>
      </ul>
    </nav>
    <div class="col meta">
      <h2 class="label">{d.footer.rights}</h2>
      <p>{before}<a href={href('/#contact', lang)}>{d.footer.rightsLink}</a>{after}</p>
      <p class="small">© {year} {site.name}. {d.footer.copyright}</p>
      <p class="small credits">{d.footer.credits}</p>
    </div>
  </div>
  <div class="stripe" aria-hidden="true">
    {/* The racing-car emoji, the same car as on the divider lines (Drive.astro), mirrored to face the
        way it drives: it races the stripe when the logo is hovered. */}
    <span class="car"><span class="emoji">🏎️</span></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    position: relative;
  }
  .grid {
    display: grid;
    gap: var(--s5);
    padding-block: var(--s6) var(--s5);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1.3fr 1fr 0.7fr 1.2fr;
      gap: var(--s5);
    }
  }
  .logo {
    display: inline-block;
    width: 160px;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
    margin-top: var(--s3);
  }
  .blurb {
    margin-top: var(--s3);
    max-width: 40ch;
    color: var(--text-2);
  }
  .networks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .networks a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--text);
  }
  .dot {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 1rem;
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .networks a:hover .dot {
    transform: scale(1.1);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 30%, transparent);
  }
  .networks a:hover .dot .icon {
    animation: wiggle 0.5s var(--ease);
  }
  @keyframes wiggle {
    25% { transform: rotate(-12deg) scale(1.1); }
    75% { transform: rotate(10deg) scale(1.1); }
  }
  .networks a:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .label {
    font-size: 0.9rem;
    letter-spacing: 0.22em;
    color: var(--text-3);
    margin-bottom: var(--s3);
  }
  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .links a {
    text-decoration: none;
    color: var(--text-2);
  }
  .links a:hover {
    color: var(--text);
  }
  .meta p {
    color: var(--text-2);
    max-width: 40ch;
  }
  .small {
    font-size: 0.9rem;
    color: var(--text-3);
    margin-top: var(--s4);
  }
  .credits {
    margin-top: var(--s2);
  }
  /* Black, yellow, red: the tricolour as a finish line. */
  .stripe {
    position: relative;
    height: 6px;
    background: var(--tricolour);
  }
  .car {
    position: absolute;
    left: -80px;
    bottom: 3px;
    font-size: 28px;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }
  .car .emoji {
    display: block;
    transform: scaleX(-1);
  }
  :global(.js-motion) .site-footer.racing .car {
    animation: race 1.6s cubic-bezier(0.3, 0, 0.2, 1) forwards;
  }
  @keyframes race {
    0% { opacity: 0; transform: translateX(0); }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { opacity: 0; transform: translateX(calc(100vw + 100px)); }
  }
</style>
