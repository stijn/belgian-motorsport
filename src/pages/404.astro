---
// The 404 page is English: Cloudflare serves one 404 for the whole site.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { href } from '../lib/url';
import { t } from '../i18n';
const d = t('en');
---
<Base lang="en" path="/404/" title={`${d.notFound.title} — ${site.name}`} noindex>
  <section class="section">
    <div class="wrap center">
      <SectionHead level={1} icon="alert-circle" eyebrow="404" heading={d.notFound.heading} lead={d.notFound.text} />
      <p class="cta">
        <a class="btn btn-red" href={href('/')}>{d.notFound.back}</a>
        <a class="btn btn-ghost" href={href('/#work')}>{d.notFound.photos}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .center {
    display: grid;
    gap: var(--s4);
    justify-items: start;
    max-width: 760px;
    min-height: 60svh;
    align-content: center;
  }
  .cta {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
  }
</style>
