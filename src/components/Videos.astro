---
// The latest films, from src/data/videos.json (npm run sync). Each is a still from the site itself
// until it's clicked; then it plays from youtube-nocookie.com (src/scripts/video.ts).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fa from './Fa.astro';
import SocialIcon from './SocialIcon.astro';
import { faPlay, faArrowRight } from '@fortawesome/free-solid-svg-icons';
import videos from '../data/videos.json';
import { socials, stats } from '../data/site';

interface Props {
  count?: number;
}
const { count = 6 } = Astro.props;
const stills = import.meta.glob<{ default: ImageMetadata }>('../assets/videos/*.jpg', { eager: true });
const list = videos
  .map((v) => ({ ...v, still: stills[`../assets/videos/${v.id}.jpg`]?.default }))
  .filter((v) => v.still)
  .slice(0, count);
const youtube = socials.find((s) => s.key === 'youtube')!;
const subs = stats.items.find((s) => s.label.includes('subscribers'))?.value;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<section id="film" class="section film">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow rv">Film</p>
        <h2 class="h2 rv">Fast, and with a beautiful sound</h2>
      </div>
      <p class="lead rv">Flybys, flames, downshifts and on-boards, cut to the engine rather than a soundtrack. {subs ? `${subs}+ people subscribe` : 'People subscribe'} to the channel; the newest films are here.</p>
    </div>

    <ul class="grid" data-stagger>
      {list.map((v, i) => (
        <li class="card rv" data-video={v.id} data-title={v.title}>
          <div class="yt-still ph">
            <Picture src={v.still!} alt="" widths={[400, 640, 960]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" formats={['avif', 'webp']} quality={65} loading={i < 3 ? 'eager' : 'lazy'} />
            <button type="button" class="play" aria-label={`Play: ${v.title}`}>
              <span class="play-disc"><Fa icon={faPlay} /></span>
            </button>
          </div>
          <div class="meta">
            <h3>{v.title}</h3>
            <p><time datetime={v.published}>{fmt.format(new Date(v.published))}</time> · <a href={`https://www.youtube.com/watch?v=${v.id}`} rel="noopener">Watch on YouTube</a></p>
          </div>
        </li>
      ))}
    </ul>

    <p class="more rv">
      <a class="link-arrow" href={youtube.url} rel="me noopener">
        <SocialIcon network="youtube" /> All {stats.items.find((s) => s.label === 'films')?.value}+ films on YouTube <Fa icon={faArrowRight} />
      </a>
    </p>
  </div>
</section>
<script>
  import '../scripts/video';
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .card {
    display: grid;
    gap: var(--s3);
  }
  .yt-still {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .yt-still :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), opacity 0.6s;
  }
  .card:hover .yt-still :global(img) {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(transparent 50%, rgb(0 0 0 / 0.5));
    border: 0;
    cursor: pointer;
  }
  .play-disc {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-size: 1.3rem;
    padding-left: 0.2rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
    transition: transform 0.3s var(--ease), background 0.3s;
  }
  .play:hover .play-disc,
  .play:focus-visible .play-disc {
    transform: scale(1.1);
    background: var(--red-2);
  }
  .card :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius);
    background: #000;
  }
  h3 {
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: none;
    font-weight: 600;
    line-height: 1.15;
  }
  .meta p {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-3);
  }
  .meta a {
    color: var(--text-2);
  }
  .more {
    margin-top: var(--s5);
  }
</style>
