---
// Where the form lands without JavaScript (the Worker redirects here after sending).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Thanks — ${site.name}`} noindex>
  <section class="section">
    <div class="wrap center">
      <p class="eyebrow">Sent</p>
      <h1 class="h2">Thanks, your message is on its way.</h1>
      <p class="lead">I’ll get back to you by email, usually within a day or two.</p>
      <p><a class="btn btn-ghost" href="/">Back to the site</a></p>
    </div>
  </section>
</Base>

<style>
  .center {
    display: grid;
    gap: var(--s4);
    justify-items: start;
    max-width: 760px;
    min-height: 50svh;
    align-content: center;
  }
</style>
