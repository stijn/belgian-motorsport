---
// About him and what he can be booked for. The words live in src/i18n/. His portraits come from
// src/assets/portrait/ (1.jpg, 2.jpg, 3.jpg: cropped to 3:2, cross-fading with a slow zoom); with none
// there, a placeholder frame holds the spot.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fa from './Fa.astro';
import SocialIcon from './SocialIcon.astro';
import SectionHead from './SectionHead.astro';
import { faCamera, faFlagCheckered, faUsers, faCar, faVideo } from '@fortawesome/free-solid-svg-icons';
import { socials, serviceIcons } from '../data/site';
import { fill, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const icons = { flag: faFlagCheckered, users: faUsers, car: faCar, video: faVideo } as const;
const services = d.about.services.map((s, i) => ({ ...s, icon: icons[serviceIcons[i] ?? 'flag'] }));
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait/*.{jpg,jpeg,png}', { eager: true });
const portraits = Object.keys(found)
  .sort()
  .map((k) => found[k]!.default);
---
<section id="about" class="section about">
  <div class="wrap grid">
    <div class="text">
      <SectionHead icon="account" eyebrow={d.about.eyebrow} heading={d.about.heading} />
      <div class="copy rv">
        {d.about.long.map((p) => <p>{p}</p>)}
      </div>
      <ul class="elsewhere rv" aria-label={d.about.elsewhere}>
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="me noopener" title={s.handle} style={`--brand:${s.color}`}>
              <span class="dot"><SocialIcon network={s.key} /></span>
              <span class="net">{s.name}</span>
              <span class="count">{fill(d.about.counts[s.key], { n: s.count })}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="side">
      {portraits.length > 0 ? (
        <figure class="portrait photos rv" data-portraits>
          {portraits.map((p, i) => (
            <span class:list={['shot', { active: i === 0 }]} data-portrait>
              <Picture src={p} width={960} height={640} alt={i === 0 ? d.about.portraitAlt : ''} widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 100vw" formats={['avif', 'webp']} quality={66} loading="lazy" />
            </span>
          ))}
        </figure>
      ) : (
        <figure class="portrait rv" role="img" aria-label={d.about.portraitAlt}>
          <span class="frame">
            <Fa icon={faCamera} />
            <span class="soon">{d.about.portraitSoon}</span>
          </span>
        </figure>
      )}
      <h3 class="rv">{d.about.availableFor}</h3>
      <ul class="services" data-stagger>
        {services.map((s) => (
          <li class="rv">
            <span class="ico"><Fa icon={s.icon} /></span>
            <strong>{s.title}</strong>
            <span class="txt">{s.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<script>
  import '../scripts/portrait';
</script>

<style>
  .grid {
    display: grid;
    gap: var(--s5);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--s6);
      align-items: start;
    }
  }
  .copy {
    margin-top: var(--s4);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--text-2);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .copy p:first-child {
    color: var(--text);
    font-size: 1.15em;
  }
  .elsewhere {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .elsewhere a {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    padding: 0.4rem 0.9rem 0.4rem 0.4rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .elsewhere .dot {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 0.9rem;
    transition: transform 0.3s var(--ease);
  }
  .elsewhere .net {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.95rem;
  }
  .elsewhere .count {
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .elsewhere a:hover {
    border-color: var(--text);
    background: var(--bg-2);
  }
  .elsewhere a:hover .dot {
    transform: scale(1.1);
  }
  /* The portrait frame: landscape, a dashed edge, the camera waiting for him. */
  .portrait {
    margin: 0;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, var(--bg-2), var(--bg-3));
    border: 1px dashed var(--line-2);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }
  .portrait.photos {
    border: 0;
    background: var(--bg-3);
  }
  .portrait.photos::before {
    display: none;
  }
  .shot,
  .shot :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .shot :global(img) {
    object-fit: cover;
    max-width: none;
  }
  .shot {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .shot.active {
    opacity: 1;
  }
  .js-motion .shot.active :global(img) {
    animation: drift 6.2s linear forwards;
  }
  @keyframes drift {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(135deg, transparent 0 18px, rgb(255 255 255 / 0.025) 18px 36px);
  }
  .frame {
    position: relative;
    display: grid;
    gap: var(--s3);
    justify-items: center;
    color: var(--text-3);
    font-size: 3rem;
  }
  .soon {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .side h3 {
    margin-top: var(--s5);
    font-size: 1rem;
    letter-spacing: 0.22em;
    color: var(--text-3);
  }
  .services {
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
    display: grid;
  }
  .services li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s3);
    row-gap: 0.25rem;
    align-items: start;
    padding: var(--s3) 0 var(--s3) var(--s3);
    border-top: 1px solid var(--line);
  }
  .services li:last-child {
    border-bottom: 1px solid var(--line);
  }
  /* The red marker grows with the hover, in step with the title's colour. */
  .services li::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--s3);
    bottom: var(--s3);
    width: 3px;
    background: var(--red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s var(--ease);
  }
  .services li:hover::before {
    transform: none;
  }
  .ico {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--red);
    font-size: 1.2rem;
    transition: border-color 0.35s, transform 0.35s var(--ease);
  }
  .services li:hover .ico {
    border-color: var(--red);
    transform: scale(1.06);
  }
  .services strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: color 0.35s;
  }
  .services li:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--red);
    text-underline-offset: 0.15em;
  }
  .txt {
    color: var(--text-2);
  }
</style>
