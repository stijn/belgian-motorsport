---
// Font Awesome Free icon as inline SVG at build time (no runtime JS or webfont). Icons in the sprite
// (src/lib/fa-sprite.ts) are drawn with <use>, so each page carries their paths once; any other icon
// gets its path inline.
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';
import { inSprite, symbolId } from '../lib/fa-sprite';

interface Props {
  icon: IconDefinition;
  class?: string;
  /** An accessible name, when the icon stands alone. Without one it's decorative. */
  label?: string;
}
const { icon, class: cls, label } = Astro.props;
const [w, h, , , path] = icon.icon;
const paths = Array.isArray(path) ? path : [path];
const sprite = inSprite(icon);
---
<svg
  class:list={['icon', cls]}
  viewBox={`0 0 ${w} ${h}`}
  width={(w / h).toFixed(3) + 'em'}
  height="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>{sprite ? <use href={`#${symbolId(icon)}`} /> : paths.map((d) => <path fill="currentColor" d={d} />)}</svg>
