// A static site (dist/), plus one small Worker for /api/*: the contact form.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belgian-motorsport",
  // Stijn's Cloudflare account. Not a secret.
  "account_id": "0954ead81ed9fd06d343580d95902280",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only these paths run the Worker; everything else is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  // The form sends through Resend when the RESEND_API_KEY secret is set (docs/go-live.md, step 4).
  // Without it, Cloudflare Email Sending (this binding; needs the Workers Paid plan and an onboarded domain).
  "send_email": [{ "name": "EMAIL" }],
  // At most 5 contact messages a minute from one address.
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    // The From address. Its domain is the one onboarded to Email Sending.
    "CONTACT_FROM": "contact@belgian-motorsport.com",
    "CONTACT_FROM_NAME": "Belgian Motorsport website",
    "SITE_ORIGIN": "https://belgian-motorsport.com"
  },
  // Secrets (set with `npx wrangler secret put NAME`, never in this file):
  //   CONTACT_TO        the address that receives the form (his address; it never appears in the site)
  //   RESEND_API_KEY    a Resend key (Sending access, this domain only); the form sends through Resend
  //   TURNSTILE_SECRET  optional; switches on Cloudflare Turnstile checks
  "observability": { "enabled": true },
  // Zone routes rather than a custom domain: they sit beside the zone's existing DNS records,
  // so the switch from the old host needs no record deleted first. The www rule redirects before this.
  "routes": [
    { "pattern": "belgian-motorsport.com/*", "zone_name": "belgian-motorsport.com" },
    { "pattern": "www.belgian-motorsport.com/*", "zone_name": "belgian-motorsport.com" }
  ],
  // The demo Worker on workers.dev: the GitHub Pages demo posts its contact form here
  // (DEMO_ORIGIN allows it). `npm run deploy:demo`; secrets with `--env demo`.
  "env": {
    "demo": {
      "name": "belgian-motorsport-demo",
      "workers_dev": true,
      "routes": [],
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
      "vars": {
        "CONTACT_FROM": "contact@belgian-motorsport.com",
        "CONTACT_FROM_NAME": "Belgian Motorsport website (demo)",
        "SITE_ORIGIN": "https://belgian-motorsport-demo.stijn-vogels.workers.dev",
        "DEMO_ORIGIN": "https://stijn.github.io"
      }
    }
  }
}
